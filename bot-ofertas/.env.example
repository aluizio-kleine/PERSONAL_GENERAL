# Copie este arquivo para .env e preencha. NUNCA publique o .env (ele tem suas senhas).

# ---------- Canal ----------
NOME_CANAL=Ofertas de Eletro
# Link público do canal do Telegram (vai no fim das mensagens do WhatsApp)
LINK_TELEGRAM=https://t.me/seucanal
FUSO=America/Sao_Paulo

# ---------- Telegram ----------
# Token do @BotFather
TELEGRAM_TOKEN=
# @nome_do_canal (ou o id numérico -100...). O bot precisa ser administrador do canal.
TELEGRAM_CANAL=@seucanal
# Seu chat id: mande /id para o bot depois de ligar o robô e cole aqui
TELEGRAM_ADMIN_ID=
# Uma oferta a cada X minutos, só entre HORA_INICIO e HORA_FIM
INTERVALO_TELEGRAM_MIN=20
HORA_INICIO=8
HORA_FIM=23

# ---------- Filtro ----------
DESCONTO_MINIMO=20
PRECO_MINIMO=30
NOTA_MINIMA=4.5
# Com 3+ dias de histórico, o preço precisa estar X% abaixo do normal
QUEDA_MINIMA_HISTORICO=8
DIAS_SEM_REPETIR=7
INTERVALO_COLETA_MIN=30
# Deixe vazio para usar a lista padrão de eletrodomésticos (separe por vírgula)
PALAVRAS_CHAVE=

# ---------- Shopee Afiliados (Open API) ----------
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---------- Mercado Livre ----------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://www.google.com
ML_REFRESH_TOKEN=
# Parâmetros de afiliado copiados do Gerador de Links (tudo depois do "?")
ML_PARAMETROS_AFILIADO=
# Categoria de busca (MLB5726 = Eletrodomésticos). Vazio = sem filtro de categoria
ML_CATEGORIA=MLB5726

# ---------- WhatsApp (Evolution API) ----------
# Deixe false até terminar o aquecimento do número (7 dias)
WHATSAPP_ATIVO=false
EVOLUTION_URL=http://evolution:8080
EVOLUTION_KEY=
EVOLUTION_INSTANCIA=
# Id do grupo, termina com @g.us
WHATSAPP_GRUPO=
WHATSAPP_HORARIOS=09:00,11:30,14:00,17:00,19:30,21:00
# O WhatsApp só recebe ofertas que saíram no Telegram há pelo menos X minutos
WHATSAPP_ATRASO_MIN=60

# ---------- Vídeos ----------
RODADAS_VIDEO=07:00,12:00,19:00
VIDEOS_POR_RODADA=1
# Voz gratuita (outras: pt-BR-AntonioNeural, pt-BR-ThalitaMultilingualNeural)
VOZ_EDGE=pt-BR-FranciscaNeural
# Opcional: voz paga e mais natural
ELEVENLABS_KEY=
ELEVENLABS_VOZ=
# Opcional: caminho de um MP3 livre de direitos para tocar baixinho no fundo
MUSICA_FUNDO=
HASHTAGS=#achadinhos #eletrodomesticos #promocao #ofertas #casa

# ---------- Instagram Reels (opcional) ----------
INSTAGRAM_ID=
INSTAGRAM_TOKEN=
GRAPH_VERSAO=v23.0

# ---------- YouTube Shorts (opcional) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public / unlisted / private (apps não auditados pelo Google só conseguem private)
YOUTUBE_PRIVACIDADE=private
